# Keep the EMEET PIXY awake. Its idle power-down is the suspected trigger for the
# USB controller (0000:05:00.4) dying on 2026-11-13 when OBS was restarted.
ACTION=="add|change", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="328f", ATTR{idProduct}=="00c0", TEST=="power/control", ATTR{power/control}="on"
