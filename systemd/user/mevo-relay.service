[Unit]
Description=Pass the Mevo's SRT feed on to OBS without its audio
Documentation=file:%h/.local/bin/mevo-relay
# The Mevo drops out and reboots; keep retrying however often that happens.
StartLimitIntervalSec=0

[Service]
ExecStart=%h/.local/bin/mevo-relay
Environment="MEVO_RELAY_SRC=srt://192.168.7.33:4201?timeout=5000000"
Environment="MEVO_RELAY_DST=udp://127.0.0.1:4202?pkt_size=1316"
# always, not on-failure: a feed that stalls mid-stream makes ffmpeg exit 0.
Restart=always
# A flat delay, no RestartSteps: systemd grows a stepped delay from the restart
# counter, which only resets on a manual start or reset-failed, so one long
# outage left every later reconnect waiting the full maximum. OBS drops its input
# after 15 s without a packet. A stall that recovers costs the 5 s SRT timeout,
# this delay, and about 3 s of start-up: about 10 s, leaving 5 s of margin.
RestartSec=2

[Install]
WantedBy=default.target
