#!/usr/bin/env python3
"""Switch the EMEET PIXY's AI tracking on or off from Linux.

Usage: pixy-track [status|on|off]      (default: status)

The camera forgets its mode on reboot or replug and comes back in Standard.
The mode lives behind the camera's vendor HID interface (/dev/hidrawN, root
only unless a udev rule opens it). There is no vendor documentation; the report
layout below is the one the PixyPilot and omarchy-emeet-pixy projects worked
out, checked against this camera on 2026-11-19.

Quirks the code works around:
  - the first write on a freshly opened hidraw node is dropped
  - a mode change only commits when the mode query follows it
  - the camera ignores Standard/Tracking changes (and answers 3 to the query)
    unless video is streaming, so when nothing else is streaming this opens a
    short stream of its own for the duration of the change
"""
import glob
import os
import select
import subprocess
import sys
import time

VENDOR_PRODUCT = "0000328F:000000C0"
VENDOR_USAGE = bytes.fromhex("05830983")
REPORT_SIZE = 32
MODES = {0: "standard", 1: "tracking", 2: "privacy", 3: "idle (unknown until video streams)"}
QUERY = [0x09, 0x01, 0x01, 0x01]


def report(payload):
    return bytes(payload) + bytes(REPORT_SIZE - len(payload))


def find_hidraw():
    fallback = None
    for dev in sorted(glob.glob("/sys/class/hidraw/hidraw*")):
        try:
            uevent = open(dev + "/device/uevent").read()
            desc = open(dev + "/device/report_descriptor", "rb").read()
        except OSError:
            continue
        if VENDOR_PRODUCT not in uevent.upper():
            continue
        node = "/dev/" + os.path.basename(dev)
        if VENDOR_USAGE in desc:
            return node
        fallback = fallback or node
    return fallback


def find_video():
    nodes = sorted(glob.glob("/dev/v4l/by-id/*EMEET*PIXY*index0"))
    return nodes[0] if nodes else None


def drain(fd):
    while select.select([fd], [], [], 0)[0]:
        os.read(fd, 64)


def query_mode(fd):
    """Return the mode byte, or None if the camera never answered."""
    for _ in range(4):
        drain(fd)
        os.write(fd, report(QUERY))
        deadline = time.monotonic() + 0.6
        while (left := deadline - time.monotonic()) > 0:
            if not select.select([fd], [], [], left)[0]:
                break
            r = os.read(fd, 64)
            if len(r) >= 9 and r[0] == 0x09 and r[1] & 0x1F == 0x01 and r[2:4] == b"\x01\x01":
                return r[8]
    return None


def set_mode(fd, value):
    for _ in range(4):
        os.write(fd, report([0x09, 0x01, 0x01, 0x00, 0x00, 0x01, 0x00, 0x01, value]))
        time.sleep(0.05)
        got = query_mode(fd)
        if got == value:
            return got
        time.sleep(0.3)
    return got


def own_stream():
    """Stream for a few seconds if nobody else is; None if the camera is busy."""
    video = find_video()
    if not video:
        return None
    p = subprocess.Popen(
        ["v4l2-ctl", "-d", video, "--stream-mmap", "--stream-count=150", "--stream-to=/dev/null"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    time.sleep(1.5)
    if p.poll() is not None:  # exited at once: another program holds the stream
        return None
    return p


def main():
    want = sys.argv[1] if len(sys.argv) > 1 else "status"
    if want not in ("status", "on", "off"):
        sys.exit(__doc__)
    node = find_hidraw()
    for _ in range(20):  # run from udev, the HID node can lag the video node
        if node or want == "status":
            break
        time.sleep(0.5)
        node = find_hidraw()
    if not node:
        sys.exit("pixy-track: no EMEET PIXY found")
    try:
        fd = os.open(node, os.O_RDWR | os.O_NONBLOCK)
    except PermissionError:
        sys.exit(f"pixy-track: no access to {node} (run with sudo)")
    stream = None
    try:
        mode = query_mode(fd)
        for _ in range(3):  # a camera that has only just appeared can refuse the first try
            if want == "status" or mode not in (3, None):
                break
            stream = own_stream()
            mode = query_mode(fd)
        if want == "status":
            print(MODES.get(mode, f"no answer ({mode})"))
            return 0
        value = 1 if want == "on" else 0
        if mode == 2 and value == 1:
            sys.exit("pixy-track: camera is in privacy mode; leaving it alone")
        got = set_mode(fd, value)
        print(MODES.get(got, f"no answer ({got})"))
        return 0 if got == value else 1
    finally:
        os.close(fd)
        if stream:
            stream.terminate()


if __name__ == "__main__":
    sys.exit(main())
