#!/usr/bin/env python3
"""obsctl: send one obs-websocket (v5) request to the OBS on this machine.

  obsctl GetVersion
  obsctl SetCurrentProgramScene '{"sceneName": "Scope Camera"}'
  obsctl shot [SOURCE] [FILE.png]     # screenshot of a source or the program scene

Reads the port and password from OBS's own config; prints the response as JSON.
"""
import asyncio, base64, hashlib, json, os, sys

import websockets

CONF = os.path.expanduser("~/.config/obs-studio/plugin_config/obs-websocket/config.json")


async def call(requests):
    conf = json.load(open(CONF))
    async with websockets.connect(f"ws://127.0.0.1:{conf['server_port']}", max_size=64 * 2**20) as ws:
        hello = json.loads(await ws.recv())["d"]
        ident = {"rpcVersion": 1, "eventSubscriptions": 0}
        auth = hello.get("authentication")
        if auth:
            secret = base64.b64encode(hashlib.sha256((conf["server_password"] + auth["salt"]).encode()).digest())
            ident["authentication"] = base64.b64encode(
                hashlib.sha256(secret + auth["challenge"].encode()).digest()
            ).decode()
        await ws.send(json.dumps({"op": 1, "d": ident}))
        if json.loads(await ws.recv())["op"] != 2:
            raise SystemExit("obsctl: OBS refused the connection")
        out = []
        for i, (kind, data) in enumerate(requests):
            await ws.send(json.dumps({"op": 6, "d": {"requestType": kind, "requestId": str(i), "requestData": data}}))
            while True:
                msg = json.loads(await ws.recv())
                if msg["op"] == 7:
                    out.append(msg["d"])
                    break
        return out


def main(argv):
    if not argv or argv[0] in {"-h", "--help"}:
        print(__doc__)
        return 0
    if argv[0] == "shot":
        source = argv[1] if len(argv) > 1 and argv[1] else None
        path = argv[2] if len(argv) > 2 else "/tmp/obs-shot.png"
        if source is None:
            source = asyncio.run(call([("GetCurrentProgramScene", {})]))[0]["responseData"]["currentProgramSceneName"]
        d = asyncio.run(call([("GetSourceScreenshot", {"sourceName": source, "imageFormat": "png"})]))[0]
        if not d["requestStatus"]["result"]:
            print(json.dumps(d["requestStatus"]))
            return 1
        open(path, "wb").write(base64.b64decode(d["responseData"]["imageData"].split(",", 1)[1]))
        print(f"{source} -> {path}")
        return 0
    data = json.loads(argv[1]) if len(argv) > 1 else {}
    d = asyncio.run(call([(argv[0], data)]))[0]
    print(json.dumps({"ok": d["requestStatus"]["result"], **d["requestStatus"], **d.get("responseData", {})}, indent=1))
    return 0 if d["requestStatus"]["result"] else 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
